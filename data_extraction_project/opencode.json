
{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*.env": "deny",
      "*.env.*": "deny"
    },
  "bash": {
      "*": "ask",
      "git commit*": "deny",
      "git push*": "deny",
      "git pull*": "deny"
    }
    
  },
  "agent": {
    "plan": {
      "permission": {
        "edit": {
          "*": "deny",
          "~/.opencode/plan/*": "allow"
        },
        "shell": "ask",
        "bash": {
          "*": "ask",
          "git commit*": "deny",
          "git push*": "deny",
          "git pull*": "deny"
        }
      }
    }
  }
}
